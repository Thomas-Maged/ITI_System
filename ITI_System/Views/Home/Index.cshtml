@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <!-- Welcome Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to ITI_System</h1>

        <p class="lead text-muted mt-3">
            A simple management system for ITI.
        </p>
    </div>


    <!-- System Sections -->
    <div class="row g-4 justify-content-center text-center">

        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-4">
                <div class="p-4 border rounded shadow-sm h-100 d-flex flex-column">
                    <h4>Students</h4>
                    <p class="text-muted">
                        Manage student records and track their academic progress.
                    </p>
                    <a asp-controller="Student" asp-action="Index" class="btn btn-primary">
                        View Students
                    </a>
                </div>
            </div>
        }
        

        <div class="col-md-4">
            <div class="p-4 border rounded shadow-sm h-100 d-flex flex-column">
                <h4>Departments</h4>
                <p class="text-muted">
                    Organize departments and manage their courses.
                </p>
                <a asp-controller="Department" asp-action="Index" class="btn btn-primary">
                    View Departments
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="p-4 border rounded shadow-sm h-100 d-flex flex-column">
                <h4>Courses</h4>
                <p class="text-muted">
                    Manage courses and assign them to departments.
                </p>
                <a asp-controller="Course" asp-action="Index" class="btn btn-primary">
                    View Courses
                </a>
            </div>
        </div>

    </div>


    

</div>