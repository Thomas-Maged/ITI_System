@model User
@{
    ViewData["Title"] = "Login";
}

<h1>@ViewBag.type Page</h1>
<div class="container d-flex align-items-center justify-content-center mt-5">

    <div class="col-md-4">

        <div class="card shadow">

            
            <!-- Body -->
            <div class="card-body">

                <form method="post">

                    <!-- Username -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Username</label>
                        <input type="text" class="form-control" placeholder="Enter username" asp-for="UserName">
                        <span asp-validation-for="UserName"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Password</label>
                        <input type="password" class="form-control" placeholder="Enter password" asp-for="Password">
                        <span asp-validation-for="Password"></span>
                    </div>
                    @if (User.IsInRole("Admin"))
                        {
                        <!-- Roles -->
                        @* <div class="mb-4">
                            <label class="form-label fw-bold">Roles</label>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="Admin" name="Roles">
                                <label class="form-check-label">
                                    Admin
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="Instructor" name="Roles">
                                <label class="form-check-label">
                                    Instructor
                                </label>
                            </div>
                        </div> *@
                        }
                    
                    <!-- Login Button -->
                    <div class="d-grid">
                        @if (ViewBag.type == "Login")
                            {
                                <button class="btn btn-primary">Login</button>
                            }
                            else
                            {
                                <button class="btn btn-primary">Register</button>
                            }
                    </div>
                    
                    <div asp-validation-summary="ModelOnly"></div>
                </form>
            </div>

        </div>

    </div>

</div>