@model Department
@{
    ViewData["Title"] = "Edit";
    var CoursesToRemove = ViewBag.coursesToRemove;
    var CoursesToAdd = ViewBag.coursesToAdd;
}

<h1>Edit @Model.Name Department</h1>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-controller="Department" asp-action="Edit" method="post">
               

            <div class="card-body">

                <div class="mb-3">
                    <label class="fw-bold">ID</label>
                    <input readonly class="form-control bg-light" asp-for="DeptID"></input>
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Name</label>
                    <input class="form-control bg-light" asp-for="Name"></input>
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Capacity</label>
                    <input class="form-control bg-light" asp-for="Capacity"></input>
                </div>

            </div>
                
                <!-- Add Course -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Add Course</label>
                    <div class="input-group">
                        <select class="form-select" multiple size="5" name="idsToAdd">
                            <option selected disabled>Select course to add</option>
                            <@foreach(Course c in CoursesToAdd)
                            {
                                <option value="@c.CrsID">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Remove Course -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Remove Course</label>
                    <div class="input-group">
                        <select class="form-select" multiple size="5" name="idsToRemove">
                            <option selected disabled>Select course to remove</option>
                            @foreach(Course c in CoursesToRemove)
                                {
                                <option value="@c.CrsID">@c.Name</option>
                                }
                            
                        </select>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <input type="submit" class="btn btn-warning" value="Edit"></input>
                </div>
            </form>

            

        </div>

    </div>
</div>
</div>

