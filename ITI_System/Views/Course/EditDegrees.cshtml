@model EditDegreesForCourseViewModel
@{
    ViewData["Title"] = "EditDegrees";
}

<h1>Edit Degrees In @Model.Course.Name Course</h1>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">

            <div class="card shadow">

                

                <!-- Body -->
                <div class="card-body">
                    

                    <form method="post">
                        <input type="hidden" asp-for="Course.CrsID" />
                        <input type="hidden" asp-for="Course.Name" />
                        <input type="hidden" asp-for="Course.Duration" />
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>Student ID</th>
                                        <th>Student Name</th>
                                        <th>Email</th>
                                        <th>Degree</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                            int i = 0;
                                        }
                                        @foreach(var degree in Model.Degrees)
                                        {
                                        <tr>
                                            <td>@degree.Key.ID</td>
                                            <td>@degree.Key.Name</td>
                                            <td>@degree.Key.Email</td>
                                            <td>
                                                <input type="hidden"
                                                       class="form-control text-center"
                                                       min="0" max="100" asp-for="Degrees[i].Key.ID" >
                                                <input type="hidden"
                                                       class="form-control text-center"
                                                       min="0" max="100" asp-for="Degrees[i].Key.Name" >
                                                <input type="hidden"
                                                       class="form-control text-center"
                                                       min="0" max="100" asp-for="Degrees[i].Key.Email" >
                                                <input type="number"
                                                       class="form-control text-center"
                                                       min="0" max="100" asp-for="Degrees[i].Value">
                                            </td>
                                        </tr>
                                            i++;
                                        }
                                    
                                </tbody>
                            </table>
                        </div>
                        <div class="d-grid gap-2 text-end">

                        <input type="submit" class="btn btn-primary" value="Save Changes"></input>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>